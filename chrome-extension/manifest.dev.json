{
  "version": "1.0.0",
  "manifest_version": 3,
  "name": "Youtube Thumbnail",
  "description": "Transcribe Instagram instantly",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "React Chrome Extension"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "730536267617-rsc5mdfikjvngj6ho3i5oqetd1igvkuf.apps.googleusercontent.com",
    "scopes": ["profile", "email"]
  },
  "permissions": ["identity", "identity.email", "storage"],
  "host_permissions": ["<all_urls>"],
  "REACT_APP_BACKEND_URL": "https://bdd1-2601-601-a27f-ee30-4490-8e89-6edb-c774.ngrok-free.app"
}
